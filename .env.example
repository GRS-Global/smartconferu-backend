# Copy to .env and fill in. Every variable is validated at startup (src/config/env.ts).
# Generate the secrets below with:  npm run secrets:generate

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. Locally without Docker: `npm run db:serve` and use
#   postgres://postgres@127.0.0.1:54329/postgres
DATABASE_URL=
# With the local PGlite database (npm run db:serve) use 1: it cannot serve parallel connections reliably.
DATABASE_POOL_MAX=10

# The web app: email links point here, and it is the browser origin allowed to call the API.
# Must be the frontend origin: emailed links go to <APP_URL>/verify-email?token=... and <APP_URL>/reset-password?token=...
APP_URL=http://localhost:5173/prototype
CORS_ORIGINS=http://localhost:5173,http://localhost:3100

# Signing key for access tokens (Ed25519, PEM or base64 of the PEM) and its id.
JWT_PRIVATE_KEY=
JWT_KEY_ID=key-1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Mixed into the hashes of emailed codes and links (32+ characters).
TOKEN_HASH_SECRET=
# lax when app and API share a site (app.example.com + api.example.com); none if they don't.
REFRESH_COOKIE_SAMESITE=lax
# Defaults to true everywhere except NODE_ENV=development (plain http://localhost).
# REFRESH_COOKIE_SECURE=false
# Encrypts authenticator-app (two-step verification) secrets: 32 random bytes, base64.
MFA_ENCRYPTION_KEY=

# The API's own public address. Sign-in providers redirect to
#   <API_URL>/api/v1/auth/oauth/<google|microsoft|orcid>/callback
# — register exactly that URL with each provider.
API_URL=http://localhost:3000

# Sign-in providers: each is offered only when its id and secret are both set.
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft: portal.azure.com → Entra ID → App registrations (Web platform, client secret).
# To trust work/school emails, add the optional ID-token claims `email` and `xms_edov`.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# ORCID: orcid.org/developer-tools (or sandbox.orcid.org for testing; then set ORCID_ISSUER).
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# ORCID_ISSUER=https://sandbox.orcid.org

# Email: `log` prints emails to the console (development); `resend` sends them.
EMAIL_TRANSPORT=log
# Development only: return the admin sign-in code in the API response so the console fills it in.
# Never in production (the API refuses to start).
DEV_SHOW_EMAIL_CODES=false
RESEND_API_KEY=
EMAIL_FROM=Smartconferu <no-reply@example.com>
# The logo at the top of emails. Leave empty: the app's own logo is used when APP_URL is a public address;
# on localhost the name is written out instead (a mail client cannot load an image from your computer).
# EMAIL_LOGO_URL=https://your-public-site.example/smartconferu-lockup.png
# The email queue: sent from the API process every EMAIL_QUEUE_INTERVAL_MS, in batches,
# retried (1, 5, 30, 120 min) up to EMAIL_MAX_ATTEMPTS times.
EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_INTERVAL_MS=5000
EMAIL_QUEUE_BATCH_SIZE=50
EMAIL_MAX_ATTEMPTS=5
# Testing only: conference / paper emails go only to these recipient types (comma-separated, as Email Logs
# shows them: Author, Co-author, Reviewer, Chair, Super Admin, Member, Recipient, New user). The others are
# kept in Email Logs as "Not sent: test mode". Account emails (verification, codes, password reset) always go.
# Leave empty in production.
# EMAIL_ONLY_TO_ROLES=Chair,Super Admin
# Testing only: allow creating a conference whose dates are already over (to try the app with a past
# conference's real data). Keep false in production.
# ALLOW_PAST_CONFERENCE_DATES=true
# AI features (Claude; Voyage AI embeddings for paper chat). Without a key they answer 503.
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
VOYAGE_API_KEY=
AI_AUTO_INGEST=true

# Live events (GET /me/events): share them between API instances via Postgres LISTEN/NOTIFY.
REALTIME_FANOUT=true

# Background jobs (review reminders, cleanup of expired sign-in links and sessions), run from the
# API process every JOBS_INTERVAL_MS. Several instances may run them: each run takes a database lock.
JOBS_ENABLED=true
JOBS_INTERVAL_MS=3600000

# OpenAPI docs at /docs. Defaults to on, except in production.
# SWAGGER_ENABLED=true
RATE_LIMIT_PER_MINUTE=300

# Uploaded files. local = a folder on this machine (development, tests); s3 = a bucket of an
# S3-compatible store (Cloudflare R2, DigitalOcean Spaces, MinIO, AWS S3), set below.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=./storage
# For FILE_STORAGE_DRIVER=s3. The endpoint has no bucket at the end. Cloudflare R2:
# https://<account id>.r2.cloudflarestorage.com, region auto, and an R2 API token with
# "Object Read & Write" on the bucket (its Access Key ID and Secret Access Key).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true: <endpoint>/<bucket> (R2, MinIO); false: <bucket>.<endpoint>
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=25
